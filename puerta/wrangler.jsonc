{
  // Puerta de Computo v2 - icca-engine.com
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puerta-de-computo",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-21",
  "workers_dev": true,

  "routes": [
    { "pattern": "puerta.icca-engine.com", "custom_domain": true }
  ],

  // SINTAXIS VERIFICADA contra developers.cloudflare.com/workers/runtime-apis/
  // bindings/rate-limit/ (doc del 2026-04-23). NO usar "unsafe.bindings":
  // esa forma es vieja y deja el freno INERTE sin avisar.
  // "period" acepta SOLO 10 o 60. "namespace_id" va string aunque sea entero.
  // Exige wrangler >= 4.36.0.
  "ratelimits": [
    { "name": "TASA", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],

  // Workers AI. VERIFICADO EN VIVO 2026-08-22 en
  // developers.cloudflare.com/workers-ai/get-started/workers-wrangler/
  // Queda disponible en env.AI. Cuota gratis: 10.000 neuronas por dia, reset
  // 00:00 UTC.
  //
  // La puerta funciona SIN esto: la busqueda por terminos es el piso y la IA
  // solo mejora la seleccion. Y sin el KV CONTADOR el modelo NO se invoca:
  // gastar sin poder contar es la definicion de no medido.
  "ai": { "binding": "AI" },

  // Vacio A PROPOSITO: cero secretos en el arbol. SECRETO va por
  // `wrangler secret put`, generado en la maquina de su dueno.
  "vars": {},

  "observability": { "enabled": true }

  // PARA HABILITAR LA IA, dos cosas mas:
  //   npx wrangler kv namespace create CONTADOR
  //   -> "kv_namespaces": [{ "binding": "CONTADOR", "id": "el id real" }]
  //   npx wrangler secret put NEURONAS_MAX      (por ejemplo 8000, de 10.000)
  //
  // FASE C, cuando haya sala de ejecucion:
  //   npx wrangler secret put PRESUPUESTO_MAX
}
